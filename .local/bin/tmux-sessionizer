#!/usr/bin/env bash
# Fuzzy-find a folder in $HOME and open/switch to a tmux session for it

ORDER_FILE="$HOME/.config/tmux/session_order"

selected=$(find "$HOME" -mindepth 1 -maxdepth 5 -type d \( \
    -name '.cargo'       -o \
    -name '.cache'       -o \
    -name '.local'       -o \
    -name '.git'         -o \
    -name '.npm'         -o \
    -name '.mozilla'     -o \
    -name '.thunderbird' -o \
    -name '.rustup'      -o \
    -name '.pyenv'       -o \
    -name '.nvm'         -o \
    -name '.gradle'      -o \
    -name '.docker'      -o \
    -name 'node_modules' -o \
    -name 'target'       -o \
    -name '.claude'      \
\) -prune -o -type d -print 2>/dev/null \
    | sed "s|$HOME/||" \
    | sort \
    | fzf --prompt="  " \
          --height=100% \
          --border=none \
          --info=inline)

[ -z "$selected" ] && exit 0

full_path="$HOME/$selected"
session_name=$(basename "$selected" | tr '[:upper:]' '[:lower:]' | tr ' .' '_')

if ! tmux has-session -t "=$session_name" 2>/dev/null; then
    tmux new-session -ds "$session_name" -c "$full_path" -n "shell"
    session_file="$full_path/.tmux-session"
    if [ -f "$session_file" ]; then
        first=1
        while IFS= read -r wname; do
            [[ -z "$wname" ]] && continue
            if [ "$first" -eq 1 ]; then
                tmux rename-window -t "$session_name:1" "$wname"
                first=0
            else
                tmux new-window -t "$session_name" -n "$wname" -c "$full_path"
            fi
        done < "$session_file"
        tmux select-window -t "$session_name:1"
    fi
    mkdir -p "$(dirname "$ORDER_FILE")"
    grep -qx "$session_name" "$ORDER_FILE" 2>/dev/null || echo "$session_name" >> "$ORDER_FILE"
fi

tmux switch-client -t "$session_name"
