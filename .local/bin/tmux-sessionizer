#!/usr/bin/env bash
# Alt+F: fuzzy-find a folder in $HOME and open/switch to a session for it.
# If the folder has a .tmux-session file, its lines define the windows:
#   editor: nvim .
#   run
# ("name" or "name: command"; window 1 is the first line).

ORDER_FILE="$HOME/.local/state/tmux/session_order"

selected=$(find "$HOME" -mindepth 1 -maxdepth 5 -type d \( \
    -name '.cargo' -o -name '.cache' -o -name '.local' -o -name '.git' -o \
    -name '.npm' -o -name '.mozilla' -o -name '.rustup' -o -name '.pyenv' -o \
    -name '.nvm' -o -name '.gradle' -o -name '.docker' -o -name '.claude' -o \
    -name 'node_modules' -o -name 'target' -o -name '__pycache__' -o -name '.venv' \
\) -prune -o -type d -print 2>/dev/null |
    sed "s|^$HOME/||" | sort |
    fzf --prompt="  " --height=100% --border=none)

[[ -z "$selected" ]] && exit 0

dir="$HOME/$selected"
name=$(basename "$selected" | tr '[:upper:]' '[:lower:]' | tr ' .:' '___')

if ! tmux has-session -t "=$name" 2>/dev/null; then
    tmux new-session -ds "$name" -c "$dir" -n shell
    if [[ -f "$dir/.tmux-session" ]]; then
        i=0
        while IFS= read -r line; do
            [[ -z "$line" ]] && continue
            wname="${line%%:*}"; wname="${wname%% }"
            cmd=""; [[ "$line" == *:* ]] && { cmd="${line#*:}"; cmd="${cmd# }"; }
            i=$((i + 1))
            if ((i == 1)); then
                tmux rename-window -t "=$name:1" "$wname"
            else
                tmux new-window -d -t "=$name:" -n "$wname" -c "$dir"
            fi
            [[ -n "$cmd" ]] && tmux send-keys -t "=$name:$i" "$cmd" Enter
        done <"$dir/.tmux-session"
        tmux select-window -t "=$name:1"
    fi
    mkdir -p "${ORDER_FILE%/*}"
    grep -qxF "$name" "$ORDER_FILE" 2>/dev/null || echo "$name" >>"$ORDER_FILE"
fi

tmux switch-client -t "=$name"
